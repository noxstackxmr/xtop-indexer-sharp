<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**;Monero/Native/build/**;Monero/Native/tools/**;Monero/Native/cache/**</DefaultItemExcludes>
        <NativeRuntimeIdentifier Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NativeRuntimeIdentifier>
        <NativeRuntimeIdentifier Condition="'$(NativeRuntimeIdentifier)' == ''">$(NETCoreSdkRuntimeIdentifier)</NativeRuntimeIdentifier>
        <NativeLibraryFile Condition="'$(NativeRuntimeIdentifier)' == 'win-x64'">xtop_monero.dll</NativeLibraryFile>
        <NativeLibraryFile Condition="'$(NativeRuntimeIdentifier)' == 'linux-x64'">libxtop_monero.so</NativeLibraryFile>
    </PropertyGroup>

    <ItemGroup>
        <Content Remove="Monero/Native/**" />
        <None Include="Monero/Native/build/$(NativeLibraryFile)"
              Link="$(NativeLibraryFile)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
              Condition="'$(NativeLibraryFile)' != ''" />
        <None Update="Monero/Native/vendor/monero/LICENSE" TargetPath="licenses/monero/LICENSE"
              CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <None Update="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1"/>
    </ItemGroup>

    <Target Name="CheckNativeLibrary" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="'$(NativeLibraryFile)' == ''" Text="Native library supports win-x64 and linux-x64." />
        <Error Condition="!Exists('$(MSBuildProjectDirectory)/Monero/Native/build/$(NativeLibraryFile)')"
               Text="Build Monero/Native/$(NativeLibraryFile) first using build.ps1 (Windows) or build-linux.sh (Linux). Output directory: Monero/Native/build." />
    </Target>

</Project>
